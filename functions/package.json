{
  "name": "fitbit-health-dashboard-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Fitbit Health Dashboard via Google Health API v4",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest --passWithNoTests"
  },
  "engines": {
    "node": "20"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@google-cloud/secret-manager": "^5.6.0",
    "axios": "^1.7.9",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "google-auth-library": "^9.15.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ]
  }
}
